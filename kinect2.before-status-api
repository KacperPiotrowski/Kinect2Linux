#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIBFREENECT2_DIR:-$ROOT/../libfreenect2-omp}"
LIB_DIR="$(readlink -f -- "$LIB_DIR")"
CAMERA="${KINECT_IR_DEVICE:-/dev/video10}"
APP="$ROOT/bin/kinect_ir_bridge"
# One sensor, one owner: run/depth cannot open Kinect simultaneously.
# XDG_RUNTIME_DIR is per user on systemd desktops; fallback is our repo dir.
SENSOR_LOCK="${XDG_RUNTIME_DIR:-$ROOT}/kinect2-sensor.lock"

sensor_locked() {
  if ! command -v flock >/dev/null 2>&1; then
    echo "Brak narzedzia flock (pakiet util-linux)." >&2
    return 1
  fi
  local result=0
  # -F: flock replaces its process with the program and holds the lock
  # for the entire lifetime of that program (no dangling lock manager).
  flock -n -E 75 -F "$SENSOR_LOCK" "$@" || result=$?
  if [[ $result -eq 75 ]]; then
    echo 'Kinect jest juz zajety przez ./kinect2 run lub ./kinect2 depth.' >&2
    echo 'Zatrzymaj poprzedni proces; nie uruchamiaj dwoch odbiorcow naraz.' >&2
  fi
  return "$result"
}

usage() {
  cat <<'TXT'
Kinect2-Linux — eksperymentalny userspace MVP

  ./kinect2 doctor  - sprawdź dostępność biblioteki i wirtualnej kamery
  ./kinect2 build   - zbuduj most IR z naszej sprawdzonej wersji libfreenect2-omp
  ./kinect2 run     - uruchom most IR -> /dev/video10 (foreground, Ctrl+C)
  ./kinect2 preview - płynny podgląd IR i niezależna detekcja twarzy
  ./kinect2 depth   - pomiar odległości IR+Depth, sam kończy pracę (bez V4L2)
  ./kinect2 enroll  - prowadzona rejestracja 5 pozycji w Howdy
  ./kinect2 models  - pokaż modele Howdy
  ./kinect2 test    - uruchom oryginalny test Howdy

Opcjonalnie: KINECT_IR_DEVICE=/dev/video11 LIBFREENECT2_DIR=/ścieżka/do/worktree ./kinect2 ...
Kamera musi istnieć: modprobe v4l2loopback video_nr=10 card_label=Kinect-v2-IR exclusive_caps=1
TXT
}

doctor() {
  printf 'Kernel: %s\n' "$(uname -r)"
  if [[ -e "$CAMERA" ]]; then
    echo "[OK] Wirtualna kamera: $CAMERA"
  else
    echo "[!] Brak $CAMERA — załaduj v4l2loopback"; fi
  if [[ -f "$LIB_DIR/build-omp/lib/libfreenect2.so" ]]; then
    echo "[OK] Kompilacja OpenMP: $LIB_DIR/build-omp"
  else
    echo "[!] Brak biblioteki: $LIB_DIR/build-omp/lib/libfreenect2.so"
  fi
  if [[ -x "$APP" ]]; then
    echo "[OK] Most: $APP"
  else
    echo '[!] Most wymaga kompilacji: ./kinect2 build'
  fi
  command -v howdy || echo '[!] Brak Howdy (wymagane tylko do enroll/models/test)'
  command -v python3 || echo '[!] Brak python3'
  echo 'UWAGA: test nie modyfikuje modułów jądra ani PAM.'
}

build() {
  if [[ ! -f "$LIB_DIR/build-omp/lib/libfreenect2.so" ]]; then
    echo "Brak libfreenect2-omp: $LIB_DIR/build-omp/lib/libfreenect2.so" >&2
    exit 1
  fi
  mkdir -p "$ROOT/bin"
  g++ -std=c++11 -O2 \
    -I"$LIB_DIR/include" -I"$LIB_DIR/build-omp" \
    "$ROOT/src/kinect_ir_bridge.cpp" \
    -L"$LIB_DIR/build-omp/lib" \
    -Wl,-rpath,"$LIB_DIR/build-omp/lib" \
    -lfreenect2 -o "$APP"
  echo "[OK] Skompilowano $APP"
  ldd "$APP" | grep 'libfreenect2' || true
}

run() {
  if [[ ! -x "$APP" ]]; then
    echo 'Brak skompilowanego mostu. Najpierw: ./kinect2 build' >&2
    exit 1
  fi
  if [[ ! -e "$CAMERA" ]]; then
    echo "Brak $CAMERA. Załaduj v4l2loopback (instrukcja w README)." >&2
    exit 1
  fi
  # Kinect może być otwarty tylko przez jeden proces w danym momencie.
  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
  export OMP_DYNAMIC=FALSE
  sensor_locked "$APP" "$CAMERA"
}

depth_probe() {
  local depth_app="$ROOT/bin/kinect_depth_probe"
  if [[ ! -f "$LIB_DIR/build-omp/lib/libfreenect2.so" ]]; then
    echo "Brak libfreenect2-omp: $LIB_DIR/build-omp/lib/libfreenect2.so" >&2
    exit 1
  fi
  if [[ ! -x "$depth_app" || "$ROOT/src/kinect_depth_probe.cpp" -nt "$depth_app" ]]; then
    mkdir -p "$ROOT/bin"
    g++ -std=c++11 -O2 \
      -I"$LIB_DIR/include" -I"$LIB_DIR/build-omp" \
      "$ROOT/src/kinect_depth_probe.cpp" \
      -L"$LIB_DIR/build-omp/lib" \
      -Wl,-rpath,"$LIB_DIR/build-omp/lib" \
      -lfreenect2 -o "$depth_app"
  fi
  echo 'Depth test opens Kinect directly: stop ./kinect2 run before starting it.'
  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
  export OMP_DYNAMIC=FALSE
  sensor_locked "$depth_app" "${1:-120}"
}

require_howdy() {
  if ! command -v howdy >/dev/null 2>&1; then
    echo 'Howdy nie jest dostępne w PATH.' >&2; exit 1
  fi
}

enroll() {
  require_howdy
  cat <<'TXT'
REJESTRACJA PROWADZONA: 5 odrębnych modeli Howdy.
Most IR musi działać w DRUGIM terminalu: ./kinect2 run

To jest rejestracja z ręczną kontrolą pozycji: nie mamy jeszcze
automatycznego potwierdzania kąta głowy ani weryfikacji 3D.
Nie włączamy PAM i nie usuwamy istniejących modeli.

Przy każdym kroku:
  1. Ustaw głowę zgodnie z instrukcją i pozostań nieruchomo.
  2. Wciśnij Enter. Howdy poprosi o nazwę modelu — wpisz podaną etykietę.
  3. Poczekaj, aż Howdy wróci do terminala.
TXT
  local poses=(
    'Kinect-przod|Spójrz prosto w obiektyw'
    'Kinect-lewo|Obróć twarz lekko w LEWO (nie pełny profil)'
    'Kinect-prawo|Obróć twarz lekko w PRAWO'
    'Kinect-gora|Unieś lekko brodę'
    'Kinect-dol|Opuść lekko brodę'
  )
  local item label hint
  for item in "${poses[@]}"; do
    label="${item%%|*}"; hint="${item#*|}"
    printf '\n▶ %s — %s\n' "$label" "$hint"
    printf '  [Enter] kiedy jesteś gotowy; Ctrl+C przerywa: '
    IFS= read -r _ || { echo 'Przerwano.'; return 1; }
    echo "  Etykieta do wpisania w Howdy: $label"
    if ! sudo howdy add; then
      echo 'Rejestracja przerwana — poprzednie modele pozostały bez zmian.' >&2
      return 1
    fi
  done
  echo 'Zakończono 5 kroków. Zweryfikuj je: ./kinect2 models'
  echo 'PAMIĘTAJ: poprawne dodanie modeli NIE jest dowodem bezpieczeństwa logowania.'
}

case "${1:-help}" in
  doctor) doctor ;;
  build) build ;;
  run) run ;;
  preview) exec python3 "$ROOT/face/preview.py" --device "$CAMERA" ;;
  depth) depth_probe "${2:-120}" ;;
  enroll) enroll ;;
  models) require_howdy; exec sudo howdy list ;;
  test) require_howdy; exec sudo howdy test ;;
  help|-h|--help) usage ;;
  *) echo "Nieznane polecenie: $1" >&2; usage; exit 2 ;;
esac
