#!/usr/bin/env bash
# Shared opt-in runtime launcher. Packaging never enables the user service.
set -euo pipefail
if (( EUID == 0 )); then
  echo 'Run Kinect2Linux as an ordinary user, not as root.' >&2
  exit 2
fi
if [[ -z ${XDG_RUNTIME_DIR:-} || ! -d ${XDG_RUNTIME_DIR} ]]; then
  echo 'Missing XDG_RUNTIME_DIR; use a logged-in user session.' >&2
  exit 2
fi
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export OMP_DYNAMIC=FALSE
args=(--allow-device-control --frame-preview --auto-streams)
# Explicit opt-in only. A compatible host v4l2loopback and /dev/video11
# must be configured separately; do not install or load kernel modules here.
if [[ ${KINECT2_BROKER_V4L2:-0} == 1 ]]; then
  args+=(--v4l2-rgb)
fi
exec /usr/bin/kinect2-broker-hw "${args[@]}"
