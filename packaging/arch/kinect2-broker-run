#!/usr/bin/env bash
# Installed by kinect2linux-git; one broker owns physical USB.
# Does not automatically enable webcam mode or touch system devices.
set -euo pipefail

if (( EUID == 0 )); then
  echo 'Run Kinect2Linux as your normal user, never as root.' >&2
  exit 2
fi
if [[ -z ${XDG_RUNTIME_DIR:-} || ! -d ${XDG_RUNTIME_DIR} ]]; then
  echo 'Missing XDG_RUNTIME_DIR; run inside a logged-in systemd user session.' >&2
  exit 2
fi

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export OMP_DYNAMIC=FALSE
args=(--allow-device-control --frame-preview --auto-streams)

# Disabled by default; see packaging/arch/README.md before opting in.
if [[ ${KINECT2_BROKER_V4L2:-0} == 1 ]]; then
  args+=(--v4l2-rgb)
fi

exec /usr/bin/kinect2-broker-hw "${args[@]}"
