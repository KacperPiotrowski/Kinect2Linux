#!/usr/bin/env bash
# Opt-in launcher. The package does not enable this service.
set -euo pipefail

if (( EUID == 0 )); then
  echo 'The Kinect2Linux broker must run as a normal user, not root.' >&2
  exit 2
fi
if [[ -z ${XDG_RUNTIME_DIR:-} || ! -d ${XDG_RUNTIME_DIR} ]]; then
  echo 'XDG_RUNTIME_DIR is unavailable; use a logged-in systemd user session.' >&2
  exit 2
fi
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export OMP_DYNAMIC=FALSE
args=(--allow-device-control --frame-preview --auto-streams)
if [[ ${KINECT2_BROKER_V4L2:-0} == 1 ]]; then
  args+=(--v4l2-rgb)
fi
exec /usr/bin/kinect2-broker-hw "${args[@]}"
