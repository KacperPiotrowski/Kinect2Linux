# Deliberately opt-in; package installation never starts it.
[Unit]
Description=Kinect v2 Linux broker (RGB/IR/Depth)
Documentation=https://github.com/KacperPiotrowski/Kinect2Linux
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/lib/kinect2linux/kinect2-broker-run
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
