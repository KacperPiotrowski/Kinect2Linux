namespace {
constexpr int IN_W = 1920;
constexpr int IN_H = 1080;
constexpr int OUT_W = 1920;
constexpr int OUT_H = 1080;
volatile std::sig_atomic_t running = 1;
void signal_stop(int) { running = 0; }

bool setup_signals()
{
  struct sigaction sa{};
  sa.sa_handler = signal_stop;
  sigemptyset(&sa.sa_mask);
  sa.sa_flags = 0;  // don't automatically restart blocked system calls
  return sigaction(SIGTERM, &sa, nullptr) == 0 &&
         sigaction(SIGINT, &sa, nullptr) == 0;
}

inline uint8_t clamp8(int n)
{
  return static_cast<uint8_t>(n < 0 ? 0 : n > 255 ? 255 : n);
}

// ITU-R BT.601 studio-range Y'CbCr conversion. Source is BGRX or RGBX.
inline void rgb_to_yuv(uint8_t r, uint8_t g, uint8_t b, uint8_t& y, uint8_t& u, uint8_t& v)
{
  y = clamp8(((66 * r + 129 * g + 25 * b + 128) >> 8) + 16);
  u = clamp8(((-38 * r - 74 * g + 112 * b + 128) >> 8) + 128);
  v = clamp8(((112 * r - 94 * g - 18 * b + 128) >> 8) + 128);
}

void to_yuyv(const libfreenect2::Frame& frame, std::vector<uint8_t>& dst)
{
  const bool bgrx = frame.format == libfreenect2::Frame::BGRX;
  // Output full native 1920x1080, pairwise 4:2:2 chroma sampling.
  // Nearest-neighbor formula evaluates to a 1:1 source pixel mapping.
  for (int y = 0; y < OUT_H; ++y) {
    const size_t sy = static_cast<size_t>(y) * IN_H / OUT_H;
    const uint8_t* src = frame.data + sy * IN_W * 4;
    uint8_t* out = dst.data() + static_cast<size_t>(y) * OUT_W * 2;
    for (int x = 0; x < OUT_W; x += 2) {
      const size_t sx0 = static_cast<size_t>(x) * IN_W / OUT_W;
      const size_t sx1 = static_cast<size_t>(x + 1) * IN_W / OUT_W;
      const uint8_t* p0 = src + sx0 * 4;
      const uint8_t* p1 = src + sx1 * 4;
      const uint8_t r0 = p0[bgrx ? 2 : 0], g0 = p0[1], b0 = p0[bgrx ? 0 : 2];
      const uint8_t r1 = p1[bgrx ? 2 : 0], g1 = p1[1], b1 = p1[bgrx ? 0 : 2];
      uint8_t y0, u0, v0, y1, u1, v1;
      rgb_to_yuv(r0, g0, b0, y0, u0, v0);
      rgb_to_yuv(r1, g1, b1, y1, u1, v1);
      const size_t i = static_cast<size_t>(x) * 2;
      out[i] = y0;
      out[i+1] = static_cast<uint8_t>((static_cast<unsigned>(u0) + u1 + 1) / 2);
      out[i+2] = y1;
      out[i+3] = static_cast<uint8_t>((static_cast<unsigned>(v0) + v1 + 1) / 2);
    }
  }
}

enum class WriteResult { Sent, Dropped, Stop, Failed };
WriteResult push_frame(int fd, const std::vector<uint8_t>& frame)
{
  for (;;) {
    if (!running) return WriteResult::Stop;
    const ssize_t n = write(fd, frame.data(), frame.size());
    if (n == static_cast<ssize_t>(frame.size())) return WriteResult::Sent;
    if (n == -1 && errno == EINTR) continue;
    if (n == -1 && (errno == EAGAIN || errno == EWOULDBLOCK)) return WriteResult::Dropped;
    if (n >= 0) std::cerr << "Incomplete V4L2 frame write: " << n << "/" << frame.size() << "\n";
    else std::cerr << "V4L2 write error: " << strerror(errno) << "\n";
    return WriteResult::Failed;
  }
}
} // namespace


namespace {
// v4l2loopback private event (added in v0.13). This is the driver's own
// interface, not a standard V4L2 event; probe and fail closed if unsupported.
constexpr uint32_t CLIENT_USAGE = V4L2_EVENT_PRIVATE_START + 0x08E00000u + 1u;
constexpr auto IDLE_GRACE = std::chrono::seconds(5);
constexpr auto RETRY_PAUSE = std::chrono::seconds(3);
using Clock = std::chrono::steady_clock;

// 16,128,16,128 = black in limited-range YUYV, not a green/UV=0 frame.
std::vector<uint8_t> black_frame()
{
  std::vector<uint8_t> result(static_cast<size_t>(OUT_W) * OUT_H * 2);
  for (size_t i = 0; i < result.size(); i += 4) {
    result[i] = 16; result[i+1] = 128;
    result[i+2] = 16; result[i+3] = 128;
  }
  return result;
}

bool subscribe_usage(int fd)
{
  v4l2_event_subscription sub{};
  sub.type = CLIENT_USAGE;
  sub.flags = V4L2_EVENT_SUB_FL_SEND_INITIAL;
  return ioctl(fd, VIDIOC_SUBSCRIBE_EVENT, &sub) == 0;
}

// Returns false on fatal ioctl error. The SEND_INITIAL subscription tells us
// how many clients were already streaming when we attached.
bool drain_usage(int fd, unsigned& readers, Clock::time_point& idle_since)
{
  for (;;) {
    v4l2_event ev{};
    if (ioctl(fd, VIDIOC_DQEVENT, &ev) == -1) {
      if (errno == EAGAIN) return true;
      if (errno == EINTR && running) continue;
      std::cerr << "V4L2 client event error: " << strerror(errno) << "\n";
      return false;
    }
    if (ev.type != CLIENT_USAGE) continue;
    uint32_t count = 0;
    std::memcpy(&count, ev.u.data, sizeof(count));
    if (count != readers) {
      std::cerr << "Camera clients streaming: " << count << "\n";
      if (count == 0) idle_since = Clock::now();
    }
    readers = count;
  }
}

struct KinectSession {
  int lock_fd = -1;
  std::unique_ptr<libfreenect2::Freenect2> context;
  std::unique_ptr<libfreenect2::SyncMultiFrameListener> listener;
  libfreenect2::Freenect2Device* device = nullptr;
  bool streaming = false;
  uint32_t prior_seq = 0;
  bool have_seq = false;
  unsigned long long sent = 0, dropped = 0, gaps = 0;
};

void stop_kinect(KinectSession& s)
{
  if (s.device) {
    if (s.streaming) s.device->stop();
    s.device->close();
    s.device = nullptr;
    s.streaming = false;
    std::cerr << "Kinect RGB stopped: frames=" << s.sent
              << " gaps=" << s.gaps << " drops=" << s.dropped << "\n";
  }
  s.listener.reset();
  s.context.reset();
  if (s.lock_fd >= 0) {
    flock(s.lock_fd, LOCK_UN);
    close(s.lock_fd);
    s.lock_fd = -1;
  }
}

bool start_kinect(KinectSession& s, const char* lock_path)
{
  // The same flock lock as face3d and kinect2. Only hold it when USB is open.
  s.lock_fd = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC, 0600);
  if (s.lock_fd == -1 || flock(s.lock_fd, LOCK_EX | LOCK_NB) != 0) {
    std::cerr << "Kinect is busy (sensor lock), waiting for release.\n";
    stop_kinect(s);
    return false;
  }
  s.context.reset(new libfreenect2::Freenect2());
  if (s.context->enumerateDevices() < 1) {
    std::cerr << "No Kinect v2 found.\n";
    stop_kinect(s);
    return false;
  }
  s.device = s.context->openDevice(
      s.context->getDefaultDeviceSerialNumber(), new libfreenect2::CpuPacketPipeline());
  if (!s.device) {
    std::cerr << "Cannot open Kinect (already in use?).\n";
    stop_kinect(s);
    return false;
  }
  s.listener.reset(new libfreenect2::SyncMultiFrameListener(libfreenect2::Frame::Color));
  s.device->setColorFrameListener(s.listener.get());
  if (!s.device->startStreams(true, false)) {
    std::cerr << "Cannot start Kinect RGB stream.\n";
    stop_kinect(s);
    return false;
  }
  s.streaming = true;
  s.sent = s.dropped = s.gaps = 0;
  s.have_seq = false;
  std::cerr << "Kinect ON: RGB 1920x1080 @ up to 30 FPS\n";
  return true;
}

bool send_color_frame(KinectSession& s, int fd, std::vector<uint8_t>& yuyv)
{
  libfreenect2::FrameMap frames;
  if (!s.listener->waitForNewFrame(frames, 100)) return true;
  const auto it = frames.find(libfreenect2::Frame::Color);
  if (it == frames.end() || !it->second) {
    s.listener->release(frames);
    return true;
  }
  const libfreenect2::Frame* color = it->second;
  if (!color->data || color->width != IN_W || color->height != IN_H ||
      color->bytes_per_pixel != 4 ||
      (color->format != libfreenect2::Frame::BGRX &&
       color->format != libfreenect2::Frame::RGBX)) {
    std::cerr << "Unexpected Kinect RGB frame format.\n";
    s.listener->release(frames);
    return false;
  }
  if (s.have_seq && color->sequence > s.prior_seq + 1)
    s.gaps += color->sequence - s.prior_seq - 1;
  s.prior_seq = color->sequence;
  s.have_seq = true;
  to_yuyv(*color, yuyv);
  s.listener->release(frames);
  const WriteResult res = push_frame(fd, yuyv);
  if (res == WriteResult::Failed) return false;
  if (res == WriteResult::Sent) {
    ++s.sent;
    if (s.sent % 300 == 0)
      std::cerr << "RGB frames=" << s.sent << " seq_gaps=" << s.gaps
                << " output_drops=" << s.dropped << "\n";
  } else if (res == WriteResult::Dropped) {
    ++s.dropped;
  }
  return true;
}
} // namespace

int main(int argc, char** argv)
{
  bool probe = false, always_on = false;
  std::string path = "/dev/video11";
  for (int i = 1; i < argc; ++i) {
    if (std::strcmp(argv[i], "--probe") == 0) probe = true;
    else if (std::strcmp(argv[i], "--always-on") == 0) always_on = true;
    else if (argv[i][0] == '/' && path == "/dev/video11") path = argv[i];
    else {
      std::cerr << "Usage: " << argv[0] << " [/dev/video11] [--probe|--always-on]\n";
      return 2;
    }
  }
  if (!setup_signals()) {
    std::cerr << "Cannot install signal handlers: " << strerror(errno) << "\n";
    return 1;
  }
  // Probe is read-only and can be used while the old RGB daemon is running.
  if (probe) {
    int test_fd = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
    if (test_fd < 0) {
      std::cerr << "Cannot open " << path << ": " << strerror(errno) << "\n";
      return 1;
    }
    const bool ok = subscribe_usage(test_fd);
    if (!ok) std::cerr << "v4l2loopback client usage events unsupported: " << strerror(errno) << "\n";
    else std::cout << "OK: v4l2loopback CLIENT_USAGE events supported.\n";
    close(test_fd);
    return ok ? 0 : 1;
  }
  int fd = open(path.c_str(), O_WRONLY | O_NONBLOCK | O_CLOEXEC);
  if (fd < 0) {
    std::cerr << "Cannot open virtual camera " << path << ": " << strerror(errno) << "\n";
    return 1;
  }
  v4l2_format fmt{};
  fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
  fmt.fmt.pix.width = OUT_W;
  fmt.fmt.pix.height = OUT_H;
  fmt.fmt.pix.pixelformat = V4L2_PIX_FMT_YUYV;
  fmt.fmt.pix.field = V4L2_FIELD_NONE;
  fmt.fmt.pix.colorspace = V4L2_COLORSPACE_SMPTE170M;
  fmt.fmt.pix.bytesperline = OUT_W * 2;
  fmt.fmt.pix.sizeimage = OUT_W * OUT_H * 2;
  if (ioctl(fd, VIDIOC_S_FMT, &fmt) != 0 ||
      fmt.fmt.pix.width != OUT_W || fmt.fmt.pix.height != OUT_H ||
      fmt.fmt.pix.pixelformat != V4L2_PIX_FMT_YUYV ||
      fmt.fmt.pix.bytesperline != OUT_W * 2) {
    std::cerr << "Cannot negotiate 1920x1080 YUYV on " << path << "\n";
    close(fd);
    return 1;
  }
  v4l2_streamparm parm{};
  parm.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
  parm.parm.output.timeperframe.numerator = 1;
  parm.parm.output.timeperframe.denominator = 30;
  ioctl(fd, VIDIOC_S_PARM, &parm); // best effort

  if (!always_on && !subscribe_usage(fd)) {
    std::cerr << "v4l2loopback CLIENT_USAGE events unavailable (" << strerror(errno)
              << "). Keeping sensor OFF. Revert patch if module is incompatible.\n";
    close(fd);
    return 1;
  }
  const char* lock_path = std::getenv("KINECT_RGB_LOCK");
  if (!lock_path || !*lock_path) {
    std::cerr << "KINECT_RGB_LOCK environment variable missing (use webcam/run.sh).\n";
    close(fd);
    return 1;
  }
  std::vector<uint8_t> yuyv(static_cast<size_t>(OUT_W) * OUT_H * 2);
  const std::vector<uint8_t> blank = black_frame();
  const WriteResult first_blank = push_frame(fd, blank);
  if (first_blank == WriteResult::Failed) {
    std::cerr << "Cannot initialize standby black frame.\n";
    close(fd);
    return 1;
  }
  KinectSession session;
  unsigned readers = always_on ? 1u : 0u;
  auto idle_since = Clock::now();
  auto next_retry = Clock::now();
  std::cerr << "Kinect RGB webcam ready on " << path
            << (always_on ? " (always-on compatibility)\n" : " (on-demand, Kinect OFF)\n");

  bool good = true;
  while (running) {
    if (!always_on && !drain_usage(fd, readers, idle_since)) { good = false; break; }
    const auto now = Clock::now();
    if (session.device && !always_on && readers == 0 && now - idle_since >= IDLE_GRACE) {
      stop_kinect(session);
      const WriteResult blank_status = push_frame(fd, blank); // never leave last face visible
      if (blank_status == WriteResult::Failed) { good = false; break; }
      std::cerr << "STANDBY: Kinect OFF; virtual camera remains available.\n";
    }
    if (!session.device && readers > 0 && now >= next_retry) {
      if (!start_kinect(session, lock_path)) {
        next_retry = Clock::now() + RETRY_PAUSE;
      }
    }
    if (session.device) {
      if (!send_color_frame(session, fd, yuyv)) { good = false; break; }
    } else {
      pollfd pfd{};
      pfd.fd = fd;
      pfd.events = POLLPRI;
      const int n = poll(&pfd, 1, 200);
      if (n == -1 && errno != EINTR) {
        std::cerr << "Camera event poll failed: " << strerror(errno) << "\n";
        good = false; break;
      }
      if (n > 0 && (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))) {
        std::cerr << "Camera device disconnected or in error state.\n";
        good = false; break;
      }
    }
  }
  stop_kinect(session);
  if (running == 0 && !always_on) (void)push_frame(fd, blank);
  close(fd);
  return good ? 0 : 1;
}
