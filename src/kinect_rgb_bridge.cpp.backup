// Kinect v2 RGB -> v4l2loopback YUYV (1920x1080 @ up to 30 fps).
// Standalone userspace webcam producer; does not change Howdy, PAM or IR bridge.
#include <libfreenect2/libfreenect2.hpp>
#include <libfreenect2/frame_listener_impl.h>
#include <libfreenect2/packet_pipeline.h>

#include <linux/videodev2.h>
#include <sys/ioctl.h>
#include <fcntl.h>
#include <unistd.h>
#include <cerrno>
#include <csignal>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <string>
#include <vector>

namespace {
constexpr int IN_W = 1920;
constexpr int IN_H = 1080;
constexpr int OUT_W = 1920;
constexpr int OUT_H = 1080;
volatile std::sig_atomic_t running = 1;
void signal_stop(int) { running = 0; }

bool setup_signals()
{
  struct sigaction sa{};
  sa.sa_handler = signal_stop;
  sigemptyset(&sa.sa_mask);
  sa.sa_flags = 0;  // don't automatically restart blocked system calls
  return sigaction(SIGTERM, &sa, nullptr) == 0 &&
         sigaction(SIGINT, &sa, nullptr) == 0;
}

inline uint8_t clamp8(int n)
{
  return static_cast<uint8_t>(n < 0 ? 0 : n > 255 ? 255 : n);
}

// ITU-R BT.601 studio-range Y'CbCr conversion. Source is BGRX or RGBX.
inline void rgb_to_yuv(uint8_t r, uint8_t g, uint8_t b, uint8_t& y, uint8_t& u, uint8_t& v)
{
  y = clamp8(((66 * r + 129 * g + 25 * b + 128) >> 8) + 16);
  u = clamp8(((-38 * r - 74 * g + 112 * b + 128) >> 8) + 128);
  v = clamp8(((112 * r - 94 * g - 18 * b + 128) >> 8) + 128);
}

void to_yuyv(const libfreenect2::Frame& frame, std::vector<uint8_t>& dst)
{
  const bool bgrx = frame.format == libfreenect2::Frame::BGRX;
  // Output full native 1920x1080, pairwise 4:2:2 chroma sampling.
  // Nearest-neighbor formula evaluates to a 1:1 source pixel mapping.
  for (int y = 0; y < OUT_H; ++y) {
    const size_t sy = static_cast<size_t>(y) * IN_H / OUT_H;
    const uint8_t* src = frame.data + sy * IN_W * 4;
    uint8_t* out = dst.data() + static_cast<size_t>(y) * OUT_W * 2;
    for (int x = 0; x < OUT_W; x += 2) {
      const size_t sx0 = static_cast<size_t>(x) * IN_W / OUT_W;
      const size_t sx1 = static_cast<size_t>(x + 1) * IN_W / OUT_W;
      const uint8_t* p0 = src + sx0 * 4;
      const uint8_t* p1 = src + sx1 * 4;
      const uint8_t r0 = p0[bgrx ? 2 : 0], g0 = p0[1], b0 = p0[bgrx ? 0 : 2];
      const uint8_t r1 = p1[bgrx ? 2 : 0], g1 = p1[1], b1 = p1[bgrx ? 0 : 2];
      uint8_t y0, u0, v0, y1, u1, v1;
      rgb_to_yuv(r0, g0, b0, y0, u0, v0);
      rgb_to_yuv(r1, g1, b1, y1, u1, v1);
      const size_t i = static_cast<size_t>(x) * 2;
      out[i] = y0;
      out[i+1] = static_cast<uint8_t>((static_cast<unsigned>(u0) + u1 + 1) / 2);
      out[i+2] = y1;
      out[i+3] = static_cast<uint8_t>((static_cast<unsigned>(v0) + v1 + 1) / 2);
    }
  }
}

enum class WriteResult { Sent, Dropped, Stop, Failed };
WriteResult push_frame(int fd, const std::vector<uint8_t>& frame)
{
  for (;;) {
    if (!running) return WriteResult::Stop;
    const ssize_t n = write(fd, frame.data(), frame.size());
    if (n == static_cast<ssize_t>(frame.size())) return WriteResult::Sent;
    if (n == -1 && errno == EINTR) continue;
    if (n == -1 && (errno == EAGAIN || errno == EWOULDBLOCK)) return WriteResult::Dropped;
    if (n >= 0) std::cerr << "Incomplete V4L2 frame write: " << n << "/" << frame.size() << "\n";
    else std::cerr << "V4L2 write error: " << strerror(errno) << "\n";
    return WriteResult::Failed;
  }
}
} // namespace

int main(int argc, char** argv)
{
  if (argc > 2) {
    std::cerr << "Usage: " << argv[0] << " [/dev/video11]\n";
    return 2;
  }
  if (!setup_signals()) {
    std::cerr << "Cannot install signal handlers: " << strerror(errno) << "\n";
    return 1;
  }
  const std::string path = argc == 2 ? argv[1] : "/dev/video11";
  int fd = open(path.c_str(), O_WRONLY | O_NONBLOCK | O_CLOEXEC);
  if (fd < 0) {
    std::cerr << "Cannot open virtual camera " << path << ": " << strerror(errno) << "\n";
    return 1;
  }

  v4l2_format fmt{};
  fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
  fmt.fmt.pix.width = OUT_W;
  fmt.fmt.pix.height = OUT_H;
  fmt.fmt.pix.pixelformat = V4L2_PIX_FMT_YUYV;
  fmt.fmt.pix.field = V4L2_FIELD_NONE;
  fmt.fmt.pix.colorspace = V4L2_COLORSPACE_SMPTE170M;
  fmt.fmt.pix.bytesperline = OUT_W * 2;
  fmt.fmt.pix.sizeimage = OUT_W * OUT_H * 2;
  if (ioctl(fd, VIDIOC_S_FMT, &fmt) != 0 ||
      fmt.fmt.pix.width != OUT_W || fmt.fmt.pix.height != OUT_H ||
      fmt.fmt.pix.pixelformat != V4L2_PIX_FMT_YUYV ||
      fmt.fmt.pix.bytesperline != OUT_W * 2) {
    std::cerr << "Cannot negotiate 1920x1080 YUYV on " << path << "\n";
    close(fd);
    return 1;
  }
  v4l2_streamparm parm{};
  parm.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
  parm.parm.output.timeperframe.numerator = 1;
  parm.parm.output.timeperframe.denominator = 30;
  ioctl(fd, VIDIOC_S_PARM, &parm); // best effort

  libfreenect2::Freenect2 context;
  if (context.enumerateDevices() < 1) {
    std::cerr << "No Kinect v2 found.\n";
    close(fd);
    return 1;
  }
  libfreenect2::Freenect2Device* device = context.openDevice(
      context.getDefaultDeviceSerialNumber(), new libfreenect2::CpuPacketPipeline());
  if (!device) {
    std::cerr << "Cannot open Kinect (already in use?).\n";
    close(fd);
    return 1;
  }
  libfreenect2::SyncMultiFrameListener listener(libfreenect2::Frame::Color);
  device->setColorFrameListener(&listener);
  if (!device->startStreams(true, false)) {
    std::cerr << "Cannot start Kinect RGB stream.\n";
    device->close();
    close(fd);
    return 1;
  }

  std::vector<uint8_t> yuyv(static_cast<size_t>(OUT_W) * OUT_H * 2);
  unsigned long long sent = 0, dropped = 0, gaps = 0;
  uint32_t prior_seq = 0;
  bool have_seq = false, success = true;
  std::cerr << "Kinect RGB 1920x1080 -> 1920x1080 YUYV " << path << " (Ctrl+C to stop)\n";
  while (running) {
    libfreenect2::FrameMap frames;
    if (!listener.waitForNewFrame(frames, 500)) continue;
    auto it = frames.find(libfreenect2::Frame::Color);
    if (it == frames.end() || it->second == nullptr) {
      listener.release(frames);
      continue;
    }
    const libfreenect2::Frame* color = it->second;
    if (!color->data || color->width != IN_W || color->height != IN_H ||
        color->bytes_per_pixel != 4 ||
        (color->format != libfreenect2::Frame::BGRX &&
         color->format != libfreenect2::Frame::RGBX)) {
      std::cerr << "Unexpected Kinect RGB frame format.\n";
      listener.release(frames);
      success = false;
      break;
    }
    if (have_seq && color->sequence > prior_seq + 1)
      gaps += color->sequence - prior_seq - 1;
    prior_seq = color->sequence;
    have_seq = true;
    to_yuyv(*color, yuyv);
    listener.release(frames);
    const WriteResult status = push_frame(fd, yuyv);
    if (status == WriteResult::Stop) break;
    if (status == WriteResult::Failed) { success = false; break; }
    if (status == WriteResult::Sent) ++sent;
    else ++dropped;
    if (sent > 0 && sent % 300 == 0 && status == WriteResult::Sent)
      std::cerr << "RGB frames=" << sent << " seq_gaps=" << gaps << " output_drops=" << dropped << "\n";
  }
  device->stop();
  device->close();
  close(fd);
  std::cerr << "Kinect RGB stopped: frames=" << sent << " gaps=" << gaps << " drops=" << dropped << "\n";
  return success ? 0 : 1;
}
